# runtime data (your own game history)
db/
*.db
*.db-shm
*.db-wal
collector_errors.log
config.json

# icons are extracted from YOUR game installation at first start (not redistributed)
dashboard/static/icons/

# saved supply chains of the demo database (the real ones live in db/ next to the database)
test/chains.json

# real snapshots captured from the game (private, large)
test/live_real_*.lua

# python
__pycache__/
*.pyc
python_embedded/

# release artefacts
release/

# mod.io entry id written by the in-game Mod Hub after upload (identifies the author's own mod.io entry; never share it)
mod/**/_metadata/mod.io_fileid.txt

# local tooling / scratch
dashboard/static/_probe*.html
*.ico
Thumbs.db
desktop.ini
